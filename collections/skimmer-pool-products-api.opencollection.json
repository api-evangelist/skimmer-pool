{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skimmer Public Bodies of Water Products API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "skimmer-api-key",
      "value": "{{skimmer-api-key}}",
      "placement": "header"
    }
  },
