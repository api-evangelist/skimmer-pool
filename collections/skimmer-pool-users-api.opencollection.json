{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skimmer Public Bodies of Water Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "skimmer-api-key",
      "value": "{{skimmer-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://publicapi.getskimmer.com/Users"
          },
          "docs": "Retrieves all users - owners, admins, and technicians."
        }
      ]
    }
  ],
  "bundled": true
}